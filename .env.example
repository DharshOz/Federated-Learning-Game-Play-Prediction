# Arcane Clash — Server & Federated Learning Configuration

# MongoDB Atlas (Replace <DB_USERNAME> and <DB_PASSWORD> with your Atlas cluster credentials)
# If left with placeholders, unreachable, or empty, the system automatically falls back to resilient local JSON storage
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@cluster0.uzi1r.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=arcane_clash

# Backend Server
BACKEND_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# Federated Learning & Privacy Parameters
FL_ROUNDS=5
FL_LOCAL_EPOCHS=3
FL_BATCH_SIZE=16
FL_LEARNING_RATE=0.005
FL_MIN_CLIENTS=2
FL_DP_EPSILON=1.5

# Groq LLM Playstyle Agent (Set GROQ_API_KEY to your key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
