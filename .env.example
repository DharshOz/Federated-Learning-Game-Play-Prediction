# Arcane Clash — Server & Federated Learning Configuration

# MongoDB connection URI (e.g., Atlas cloud cluster: mongodb+srv://<user>:<password>@cluster.mongodb.net/arcane_clash)
# If left as localhost or blank, the backend auto-falls back to resilient local storage without crashing
MONGODB_URI=mongodb://localhost:27017/arcane_clash
MONGODB_DB_NAME=arcane_clash

# Backend Server URL (Game clients send match telemetry & heartbeats here)
# Set to your public server URL (e.g., https://arcane-clash-fl.onrender.com) so anyone playing around the world syncs to your dashboard
BACKEND_URL=http://localhost:8000

# Server Listening Port & Host
HOST=0.0.0.0
PORT=8000

# Federated Learning & Privacy Parameters
FL_ROUNDS=5
FL_LOCAL_EPOCHS=3
FL_BATCH_SIZE=16
FL_LEARNING_RATE=0.005
FL_MIN_CLIENTS=2
FL_DP_EPSILON=1.5

# Groq LLM Playstyle Agent
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
